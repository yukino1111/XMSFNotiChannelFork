<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XMSFNotiChannelFork"
        tools:targetApi="31">

        <activity
            android:name=".activity.HomeActivity"
            android:exported="true" />

        <activity-alias
            android:name=".activity.LauncherAlias"
            android:exported="true"
            android:targetActivity=".activity.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".activity.MainActivityAlias"
            android:exported="true"
            android:targetActivity=".activity.HomeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity-alias>

        <receiver
            android:name=".receiver.NotiControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            tools:ignore="ProtectedPermissions">
            <intent-filter>
                <action android:name="com.yukino1111.xmsfnotichannelfork.ACTION_EXPORT_REPORT" />
                <action android:name="com.yukino1111.xmsfnotichannelfork.ACTION_SET_CHANNELS" />
                <action android:name="com.yukino1111.xmsfnotichannelfork.ACTION_CLEAR_HISTORY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
